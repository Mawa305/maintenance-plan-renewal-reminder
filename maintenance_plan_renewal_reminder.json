      "parameters": {
        "jsCode": "const today = new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Karachi' });\nconst toDay = s => { const [y, m, d] = s.split('-').map(Number); return Date.UTC(y, m - 1, d) / 86400000; };\nconst emailOk = e => /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(e || '');\n\nreturn $input.all().map(({ json: r }) => {\n  let action = 'skip', stage = null, daysLeft = null;\n  const dateOk = /^\\d{4}-\\d{2}-\\d{2}$/.test(r.plan_end_date || '');\n\n  if (!emailOk(r.email) || !dateOk) {\n    action = 'invalid';\n  } else {\n    daysLeft = toDay(r.plan_end_date) - toDay(today);\n    if (daysLeft >= 0 && daysLeft <= 7) stage = '7d';\n    else if (daysLeft > 7 && daysLeft <= 14) stage = '14d';\n    else if (daysLeft > 14 && daysLeft <= 30) stage = '30d';\n    if (stage && r.reminder_status !== 'sent_' + stage) action = 'send';\n  }\n  return { json: { ...r, days_left: daysLeft, stage, action } };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
